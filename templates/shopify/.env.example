# Port the adapter listens on.
PORT=4000

# openssl rand -hex 32, then paste the SAME value into your project's Store
# screen. Required: unsigned traffic hands your catalogue to anyone with the URL.
ADAPTER_SHARED_SECRET=

# --- single-store mode, all optional ----------------------------------------
# Fill these in and the project's Store screen can be left blank; leave them out
# and what the shop admin types there is used. ONE instance for MANY shops: none.

# Where shoppers browse — your own domain if you have one, since this is the
# origin allowed to embed the advisor and where its cart requests go.
# SHOPIFY_STORE_URL=https://shop.example.com

# The permanent address the Admin API answers on.
# SHOPIFY_SHOP_DOMAIN=my-shop.myshopify.com

# Settings -> Apps and sales channels -> Develop apps -> your app -> API
# credentials. Scopes: read_products, read_inventory, and read_customers +
# read_orders for order history.
# SHOPIFY_ADMIN_TOKEN=

# Must equal the secret in the theme snippet, or every shopper is a guest.
# SHOPIFY_IDENTITY_SECRET=

# How many past orders the bot may use as context. Default 3.
# CUSTOMER_ORDERS_LIMIT=3

# Variants cost query points rather than requests on Shopify, so this is on by
# default; turning it off buys bigger pages on a very large catalogue.
# SHOPIFY_SYNC_VARIANTS=true

# Which metafields become product attributes.
# SHOPIFY_METAFIELD_NAMESPACE=custom

# Shopify retires an API version about a year after releasing it.
# SHOPIFY_API_VERSION=2026-07

# Only for a shop selling through Shopify Markets under a path, e.g. /en-ca.
# SHOPIFY_CART_PATH_PREFIX=

# Only when the catalogue should be indexed in something other than the shop's
# own currency.
# SHOPIFY_CURRENCY=HUF

# Set this and the webhook route also requires Shopify's own signature. On a
# single-store deployment you can hold that secret, so you may as well.
# SHOPIFY_WEBHOOK_SECRET=

# Local development only; refuses to start under NODE_ENV=production.
# ADAPTER_ALLOW_UNSIGNED=true

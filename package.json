{
  "name": "@smartitory/agorai-adapter",
  "version": "0.1.0",
  "author": "Smartitory",
  "license": "MIT",
  "description": "SDK for building an AgorAI store adapter: implement a few interfaces, call run(), deploy one container.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartitorysoft/agorai-adapter.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "default": "./dist/testkit/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "contract": [
        "dist/contract/index.d.ts"
      ],
      "testkit": [
        "dist/testkit/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "knip": "knip",
    "checkup": "tsc --noEmit && echo 'No typescript errors' && eslint && echo 'No eslint errors' && knip",
    "test:smoke": "node test/smoke.js",
    "verify": "pnpm run checkup && pnpm run build && pnpm run verify:template && pnpm run test:smoke && pnpm run test:woocommerce",
    "verify:template": "tsc -p tsconfig.template-check.json",
    "build:template-test": "tsc -p tsconfig.template-test.json",
    "test:woocommerce": "pnpm run build:template-test && node test/woocommerce.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.2.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.5"
  },
  "devDependencies": {
    "@agorai/eslint-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.2",
    "eslint": "^9",
    "knip": "^5.86.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}

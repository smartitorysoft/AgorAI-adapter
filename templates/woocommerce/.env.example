# Port the adapter listens on.
PORT=4000

# openssl rand -hex 32, then paste the SAME value into your project's Store
# screen. Required: unsigned traffic hands your catalogue to anyone with the URL.
ADAPTER_SHARED_SECRET=

# --- single-store mode, all optional ----------------------------------------
# Fill these in and the project's Store screen can be left blank; leave them out
# and what the shop admin types there is used. ONE instance for MANY shops: none.

# https://shop.example.com — no trailing slash, no path.
# WOOCOMMERCE_URL=

# WooCommerce -> Settings -> Advanced -> REST API -> Add key, Read permission.
# Grant Read on orders too for the bot to know what a returning shopper bought.
# WOOCOMMERCE_CONSUMER_KEY=
# WOOCOMMERCE_CONSUMER_SECRET=

# Must equal AGORAI_IDENTITY_SECRET in wp-config.php, or every shopper is a guest.
# WP_IDENTITY_SECRET=

# How many past orders the bot may use as context. Default 3.
# CUSTOMER_ORDERS_LIMIT=3

# One extra request per variable product on every sync, so off unless answers
# need sizes or colours — the bot cannot cart a variable product either way.
# WOOCOMMERCE_SYNC_VARIANTS=false

# Only if the shop's currency cannot be read from the API.
# WOOCOMMERCE_CURRENCY=HUF

# Local development only; refuses to start under NODE_ENV=production.
# ADAPTER_ALLOW_UNSIGNED=true

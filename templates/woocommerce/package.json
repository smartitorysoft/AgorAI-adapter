{
  "name": "woocommerce-agorai-adapter",
  "version": "1.0.0",
  "private": true,
  "description": "AgorAI adapter for a WooCommerce store.",
  "main": "dist/adapter.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/adapter.js",
    "dev": "tsc --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch dist/adapter.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@smartitory/agorai-adapter": "github:smartitorysoft/agorai-adapter#v0.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}

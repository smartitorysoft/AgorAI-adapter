# Port the adapter listens on.
PORT=4000

# Shared with the platform. Generate with `openssl rand -hex 32`, then paste the
# SAME value into your project's Store screen. The adapter refuses to start
# without it — every request carries your store's credentials, so an adapter
# that accepted unsigned traffic would hand your catalogue to anyone who found
# the URL.
ADAPTER_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL, and only for running this as a single-store
# adapter. Fill these in and the project's Store screen can be left blank;
# leave them out and the values the shop admin types on that screen are used.
#
# If you deploy ONE instance of this adapter for MANY shops, set none of them —
# see the note at the top of src/config.ts.
# ---------------------------------------------------------------------------

# https://shop.example.com — no trailing slash, no path.
# WOOCOMMERCE_URL=

# WooCommerce -> Settings -> Advanced -> REST API -> Add key, Read permission.
# Grant Read access to orders too if you want the bot to know what a returning
# shopper bought before.
# WOOCOMMERCE_CONSUMER_KEY=
# WOOCOMMERCE_CONSUMER_SECRET=

# Must equal AGORAI_IDENTITY_SECRET in wp-config.php. Without it every shopper
# is a guest.
# WP_IDENTITY_SECRET=

# How many past orders the bot may use as context. Default 3.
# CUSTOMER_ORDERS_LIMIT=3

# Read each variable product's variations. Costs one extra request per variable
# product on every sync, so it is off unless answers need sizes or colours — the
# bot cannot add a variable product to a cart either way. See the README.
# WOOCOMMERCE_SYNC_VARIANTS=false

# Only if the shop's currency cannot be read from the API.
# WOOCOMMERCE_CURRENCY=HUF

# Local development only. Never set this in production; the adapter refuses to
# start with it on when NODE_ENV=production.
# ADAPTER_ALLOW_UNSIGNED=true
